rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // صور الملف الشخصي وأعمال مقدم الخدمة ومرفقات الطلبات: حظر ملفات SVG القابلة للحقن وقصر الرفع على الصور النقطية الآمنة فقط
    match /{area}/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && area in ['avatars', 'works', 'requests']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }
  }
}
